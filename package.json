{
  "name": "phased",
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port ${CMUX_PORT:-4200}",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "ng e2e",
    "storybook": "ng run phased:storybook",
    "build-storybook": "ng run phased:build-storybook",
    "playwright": "npx playwright test",
    "size": "ng build --stats-json",
    "display": "npx esbuild-visualizer --metadata=dist/phased/stats.json --open=true"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/service-worker": "22.2.3",
    "@babylonjs/lite": "1.34.0",
    "@ngrx/signals": "22.0.1",
    "@stdlib/math-base-special-besselj1": "^0.3.1",
    "complex.js": "^2.4.3",
    "echarts": "^6.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "webpack": "5.111.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.4",
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/schematics": "22.6.0",
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@babel/core": "^8.0.7",
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-links": "^10.6.3",
    "@storybook/angular": "^10.6.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "angular-eslint": "22.6.0",
    "chromatic": "^18.13.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.3",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "storybook": "^10.6.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "storybook": "$storybook",
    "webpack": "$webpack"
  }
}
